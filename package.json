{
  "name": "@tagitnetwork/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK and CLI for TAG IT ERC-8004 agent contracts on Base Sepolia. Unaudited testnet software.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./a2a": {
      "import": "./dist/a2a/index.js",
      "types": "./dist/a2a/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "tagit": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "docs": "typedoc"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "viem": "^2.54.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "lint-staged": "^17.4.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.ts": "bash -c 'tsc -p tsconfig.build.json --noEmit'"
  },
  "keywords": [
    "nfc",
    "ntag424",
    "product-authentication",
    "provenance",
    "erc-8004",
    "base",
    "base-sepolia",
    "viem",
    "digital-product-passport",
    "anti-counterfeiting"
  ],
  "homepage": "https://www.tagit.network/docs/agent-quickstart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TAG-IT-NETWORK/tagit-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TAG-IT-NETWORK/tagit-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
